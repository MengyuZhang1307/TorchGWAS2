#include <stdio.h>
#include <stdlib.h>
#include <chrono>
#include <ctime>
#include <iostream>
#include <iterator>
#include <iomanip>
#include "zlib.h"
#include "zstd.h"
#include <cstring>
#include <vector>
#include <string>
#include <pybind11/pybind11.h>
#include <pybind11/numpy.h>
#include <pybind11/stl.h>

using namespace std;
namespace py = pybind11;

std::vector<std::vector<float>> bgen_Decomp(std::string bgen_file, uint64_t startPos, int range, int thread_num = 1);

void logError(const std::string& message) {
    cerr << "Error: " << message << endl;
    exit(EXIT_FAILURE);
}

template <typename T>
void readBytes(FILE * file, int num_item, T* buffer){
    if(num_item != fread(buffer, sizeof(T), num_item, file)){
         logError("on reading bgen file on position " + to_string(ftell(file)));
    }
}

template <typename T>
T read1Byte(FILE * file){
    T buffer;
    if(1 != fread(&buffer, sizeof(T), 1, file)){
         logError("on reading bgen file on position " + to_string(ftell(file)));
    }
    return buffer;
}

vector<vector<float>> bgen_Decomp(string bgen_file, uint64_t startPos, int range, int thread_num){
    // read bgen files
    FILE * Bgen_file = fopen(bgen_file.c_str(), "rb");
    fseek(Bgen_file, 0, SEEK_END);
    uint64_t EoF = ftell(Bgen_file);
    rewind(Bgen_file);
    uint64_t start_data_block = startPos;

    if(startPos > EoF){
         logError("Starting position is out of bounds.");
    }

    auto start = std::chrono::steady_clock::now();    
    //Header Block
    uint32_t offset = read1Byte<uint32_t>(Bgen_file);

    if(startPos == 0){
        start_data_block = offset + 4;
    }
    
    uint32_t header_size = read1Byte<uint32_t>(Bgen_file);
    uint32_t nVars = read1Byte<uint32_t>(Bgen_file); 
    uint32_t nSamples = read1Byte<uint32_t>(Bgen_file);
        
    //startPos is Zero based Indexing.
    //cout << "Variants: " + to_string(nVars) << endl;
    //cout << "Samples: " + to_string(nSamples) << endl;

    char magic[5];
    readBytes<char>(Bgen_file, 4, magic);

    int32_t skip_byte = (int32_t)header_size - 20;
    if(skip_byte > 0){
        fseek(Bgen_file, skip_byte, SEEK_CUR); 
    }else if(skip_byte < 0){
        logError("unusual header length - might be an invalid bgen file.");
    }

    uint32_t flags = read1Byte<uint32_t>(Bgen_file);
    
    int compress_block = flags & 3; // first 2 bit, 0 is no compress, 1 is zlib, 2 is zstd
    int layout = (flags >> 2) & 15; //2-5 bit, bgen version
    //int has_sample = (flags >> 31) & 1; If sample block present, commented out currently as not used.

    vector<uint32_t> compSizes(range), decSizes(range);
    vector<uint64_t> readStarts(range);
    vector<uint32_t> bufStarts(range + 1);
    vector<uint32_t> decDataStarts(range + 1);
    uint32_t sumStarts = 0, sumDecDataStart = 0;
    bufStarts[0] = 0;
    decDataStarts[0] = 0;

    fseek(Bgen_file, start_data_block, SEEK_SET);
    //getting compression data from each genotype block in each SNP
    for(int i = 0; i < range; i++)
    {
        //reading length of and moving past the LiD
        auto Lid = read1Byte<uint16_t>(Bgen_file);
        fseek(Bgen_file, Lid, SEEK_CUR);

        //reading length of and moving past the RSid
        auto len_rs = read1Byte<uint16_t>(Bgen_file);
        fseek(Bgen_file, len_rs, SEEK_CUR);

        //reading length of and moving past the Chr
        auto len_chr = read1Byte<uint16_t>(Bgen_file);
        fseek(Bgen_file, len_chr, SEEK_CUR);        

        //skipping SNP pos
        fseek(Bgen_file, 4, SEEK_CUR);

        //for loop for skipping alelle data
        auto n_alleles = read1Byte<uint16_t>(Bgen_file);
        for(int j = 0; j < n_alleles; j++){
            auto len_a1 = read1Byte<uint32_t>(Bgen_file);
            fseek(Bgen_file, len_a1, SEEK_CUR);   
        }

        //Genotype block data starts here
        uint32_t len_comp = read1Byte<uint32_t>(Bgen_file);
        uint32_t len_decomp;
        if(compress_block == 0){
            len_decomp = len_comp;
        }else{
            len_comp -= 4;
            len_decomp = read1Byte<uint32_t>(Bgen_file);
        }
    
        compSizes[i] = len_comp; 
        sumStarts += len_comp;
        bufStarts[i + 1] = sumStarts;
        decSizes[i] = len_decomp;
        sumDecDataStart += len_decomp + 8;
        decDataStarts[i + 1] = sumDecDataStart;
        readStarts[i] = ftell(Bgen_file);
       
        fseek(Bgen_file, len_comp, SEEK_CUR);
    }
  
    //cout << "Reading in SNP data." << endl; 
    uint8_t * snp_data = new uint8_t[bufStarts[range]]; 
    for(int i = 0; i < range; i++)
    {
        fseek(Bgen_file, readStarts[i], SEEK_SET);
        readBytes(Bgen_file, compSizes[i], snp_data + bufStarts[i]);
    }

    auto end = std::chrono::steady_clock::now();
    float secs = 0.00;
    auto duration = end - start;
    secs = std::chrono::duration_cast<std::chrono::duration<float>>(duration).count();
    //cout << "Read time: " << secs << " seconds." << endl;
    //cout << "Starting Decompression." << endl;  

    // processing each SNP.
    auto decompStart = std::chrono::steady_clock::now(); 
    uint8_t *dec_data = new uint8_t[decDataStarts[range]]; 
    //strange check!
    #pragma omp parallel for schedule(dynamic) num_threads(thread_num)
    for(int i = 0; i < range; i++)
    {
        string error_promp = to_string(i+startPos) + "th SNP of the BGEN file.";
        uint32_t len_decomp = decSizes[i];
        uint8_t * cur_snp_data = snp_data + bufStarts[i];
        uint8_t * cur_dec_data = dec_data + decDataStarts[i];
        if(compress_block == 0)
        {
            memcpy(cur_dec_data, cur_snp_data, compSizes[i]);
        }
        else
        {
            uint32_t curCompSize = compSizes[i];
            //zlib
            if(compress_block == 1){
                int z_result = uncompress((Bytef*)cur_dec_data, (uLongf*)&len_decomp, (Bytef*)cur_snp_data, curCompSize);
                if(z_result != Z_OK || len_decomp != decSizes[i]){
                    //cout << "comp size " << curCompSize << endl;
                    //cout << "decomp size " <<  len_decomp << endl;
                    //cout << decSizes[i]<< endl;
                    //cout << z_result << endl;
                     logError("decompressing genotype data error in " + error_promp); 
                }
            }else if(compress_block == 2){
                //zstd
                uint64_t const rSize = ZSTD_getFrameContentSize((void*)cur_snp_data, curCompSize);
                switch(rSize){
                case ZSTD_CONTENTSIZE_ERROR:
                    logError("not compressed by zstd in " + error_promp);
                    break;
                case ZSTD_CONTENTSIZE_UNKNOWN:
                    logError("original size unknown in " + error_promp);
                    break;
                }
                if(rSize != len_decomp){
                     logError("the size stated in compressed data is different from " + error_promp);
                }
                size_t const dSize = ZSTD_decompress((void *)cur_dec_data, len_decomp, (void*)cur_snp_data, curCompSize); 

                if(ZSTD_isError(dSize)){
                     logError("decompressing genotype error: " + string(ZSTD_getErrorName(dSize)) + " in " + error_promp);
                }
            }else{
                 logError("unknown compress format in " + error_promp);
            }
        }
    }

    delete[] snp_data;

    //cout << "Calculating dosages" << endl;
    vector<vector<doublet>> allDosages(range);

    #pragma omp parallel for schedule(dynamic) num_threads(thread_num)
    for(int i = 0; i < range; i++)
    {
        string error_promp = to_string(i+startPos) + "th SNP of the BGEN file.";
        uint32_t len_decomp = decSizes[i];
        uint8_t * cur_dec_data = dec_data + decDataStarts[i];

        uint32_t n_sample = *(uint32_t *)cur_dec_data;
        uint16_t num_alleles = *(uint16_t *)(cur_dec_data + 4);
        if(num_alleles != 2){
             logError("multi-allelic SNPs detected in " + error_promp);
        }

        uint8_t min_ploidy = *(uint8_t *)(cur_dec_data + 6);//2
        uint8_t max_ploidy = *(uint8_t *)(cur_dec_data + 7); //2
        uint8_t * sample_ploidy = (uint8_t *)(cur_dec_data + 8);
        //check all ploidy are 2 or not
        if(min_ploidy != 2){
             logError("multi-ploidy detected in " + error_promp);
        }

        uint8_t *geno_prob = sample_ploidy + n_sample;
        uint8_t is_phased = *(geno_prob);
        uint8_t bits_prob = *(geno_prob+1);
        uint8_t* X_prob = geno_prob + 2;
        uint32_t len_prob = len_decomp - n_sample - 10;
        if(is_phased){
             logError("the current version of GCTA does not support phased data in " + error_promp);
        }

        uint8_t double_bits_prob = bits_prob * 2;
        vector<uint32_t> miss_index;

        uint64_t mask = (1U << bits_prob) - 1;
        vector<double> dosages(nSamples);
        uint32_t max_dos = mask * 2 + 1;
        bool has_miss = false;
        for(int j = 0; j < nSamples; j++)
        {
            uint32_t sindex = static_cast<uint32_t>(j);
            uint8_t item_ploidy = sample_ploidy[sindex];
            if(item_ploidy > 128)
            {
                miss_index.push_back(sindex);
                has_miss = true;
                dosages[j] = static_cast<float>(max_dos);
            }
            else if(item_ploidy == 2)
            {
                uint32_t start_bits = sindex * double_bits_prob;
                uint64_t geno_temp;
                memcpy(&geno_temp, &(X_prob[start_bits/CHAR_BIT]), sizeof(uint64_t));
                geno_temp = geno_temp >> (start_bits % CHAR_BIT);
                uint32_t prob1 = geno_temp & mask;
                uint32_t prob2 = (geno_temp >> bits_prob) & mask;
                uint32_t prob1d = prob1 * 2;
                uint64_t dosage = prob1d + prob2;
                float factor = (static_cast<float>(dosage)/mask);
                //HANDLING IF  [ 0.  0.  1.]
                if(dosage !=0)
                {
                    factor = 2.0f - factor;
                }
                dosages[j] = factor;
            }
            else
            {
                logError("multi-allelic SNPs detected in " + error_promp);
            }
        }
        allDosages[i] = dosages;
    }
    
    auto decompEnd = std::chrono::steady_clock::now();
    float decSecs = 0.00;
    auto decDuration = decompEnd - decompStart;
    decSecs = std::chrono::duration_cast<std::chrono::duration<float>>(decDuration).count();
    //cout << "Decompression finished." << endl;
    //cout << "Decompression time: " << decSecs << " seconds." << endl;
    delete[] dec_data;
    fclose(Bgen_file);

    return allDosages;
}

PYBIND11_MODULE(gcta_bindings, m)
{
    m.def("bgen_Decomp", [](const string& bgen_file, uint64_t startPos, int range, int thread_num = 1){
        vector<vector<float>> result = bgen_Decomp(bgen_file, startPos, range, thread_num);
        //RETURNS as a long 1D numpy array
        py::array_t<float, py::array::f_style> arr(result.size() * result[0].size());
        float *arr_ptr = arr.mutable_data();
        for (size_t i = 0; i < result.size(); ++i) {
            std::copy(result[i].begin(), result[i].end(), arr_ptr + i * result[i].size());
        }
        return arr;
    }, py::arg("bgen_file"), py::arg("startPos"),py::arg("range"), py::arg("thread_num") = 1);
}

